<?xml version="1.0" encoding="utf-8"?>
<!-- Editor de layout em paisagem.
     - Top bar: spinner de seleção, sliders de tamanho e transparência.
     - Canvas: área onde os botões e alvos são arrastados (FrameLayout).
     - Bottom bar: Salvar / Resetar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg_dark"
        android:padding="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/editor_select"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

        <Spinner
            android:id="@+id/spinButton"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:background="@color/bg_card"
            android:popupBackground="@color/bg_card" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/editor_size"
                style="@style/EditorLabel" />

            <SeekBar
                android:id="@+id/seekSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="200"
                android:progress="100" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/editor_alpha"
                style="@style/EditorLabel" />

            <SeekBar
                android:id="@+id/seekAlpha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="255"
                android:progress="200" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/xbox_green_dark"
        android:padding="6dp"
        android:text="@string/editor_hint"
        android:textColor="@color/text_primary"
        android:textSize="11sp" />

    <!-- Canvas do editor: botões e alvos são adicionados dinamicamente aqui -->
    <FrameLayout
        android:id="@+id/editorCanvas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/bg_black" />

    <!-- Bottom bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/bg_dark"
        android:padding="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReset"
            style="@style/XboxButton.Secondary"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/editor_reset" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/XboxButton.Primary"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/editor_save" />
    </LinearLayout>
</LinearLayout>

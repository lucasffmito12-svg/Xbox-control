<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.EeIsso" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/xbox_green</item>
        <item name="colorPrimaryVariant">@color/xbox_green_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/xbox_green_bright</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:colorBackground">@color/bg_black</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">@color/bg_black</item>
        <item name="android:navigationBarColor">@color/bg_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="XboxCard">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="XboxButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="XboxButton.Primary">
        <item name="backgroundTint">@color/xbox_green</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="XboxButton.Secondary">
        <item name="backgroundTint">@color/bg_card_hover</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="strokeColor">@color/xbox_green</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="EditorLabel">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
    </style>
</resources>
